# Application Environment
NODE_ENV=development

# Backend API Endpoints
BACKEND_API_URL=https://shw-fin-b-c.onrender.com
# Optional explicit overrides (only when backend exposes auth at non-standard paths)
# BACKEND_LOGIN_URL=
# BACKEND_REGISTER_URL=
GATEWAY_BASE_URL=

# NextAuth (Auth.js v5)
# Generate with: npx auth secret  (or)  openssl rand -base64 32
AUTH_SECRET=replace_me_with_a_long_random_string
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Frontend / CORS
FRONTEND_ORIGIN=http://localhost:3000
